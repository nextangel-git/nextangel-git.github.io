---
import { articleHtml } from '../../lib/article-html.js';
import { safeHref } from '../../lib/public-safety.js';
import Base from '../../layouts/Base.astro';
import useful from '../../data/useful.json';
import { publicationInfo } from '../../lib/useful-order.js';

export function getStaticPaths() {
  return Object.entries(useful).map(([slug, a]) => ({ params: { slug }, props: { a } }));
}

const { a } = Astro.props;
---
<Base title={`${a.title} — УК «Жилкомсервис»`} description={a.title}>
  <div class="container house__wrap">
    <nav class="crumbs"><a href="/">Главная</a> → <a href="/useful">Полезное</a> → <span>{a.title}</span></nav>
    <article class="article">
      <h1 class="article__title">{a.title}</h1>
      {publicationInfo(a.publishedAt) && <p class="section__note">Опубликовано: <time datetime={publicationInfo(a.publishedAt).iso}>{a.publishedAt}</time></p>}
      <div class="article__body" set:html={articleHtml(a.body)} />
    </article>
  </div>
</Base>
