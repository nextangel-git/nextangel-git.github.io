---
import Base from '../../layouts/Base.astro';
import useful from '../../data/useful.json';
import { usefulEntries, publicationInfo } from '../../lib/useful-order.js';

const entries = usefulEntries(useful);
---
<Base title="Полезное жителям — УК «Жилкомсервис»"
      description="Статьи и ответы на частые вопросы жителей ООО УК «Жилкомсервис».">
  <div class="container house__wrap">
    <nav class="crumbs"><a href="/">Главная</a> → <span>Полезное жителям</span></nav>
    <h1>Полезное жителям</h1>
    <p class="disc-intro">Статьи и ответы на частые вопросы жителей. Новые публикации — в начале списка. Официальные документы по дому доступны через <a href="/disclosure">«Раскрытие информации»</a>.</p>
    <div class="disc-grid">
      {entries.map(([slug, a]) => (
        <a href={`/useful/${slug}`} class="disc-card"><h3>{a.title}</h3>{publicationInfo(a.publishedAt) && <p><time datetime={publicationInfo(a.publishedAt).iso}>{a.publishedAt}</time></p>}</a>
      ))}
      <a href="/faq" class="disc-card"><h3>Вопросы и ответы</h3><p>Частые вопросы жителей</p></a>
      <a href="https://dom.gosuslugi.ru" target="_blank" rel="noopener" class="disc-card"><h3>Приложение «Госуслуги Дом»</h3><p>Показания, оплата и голосования — в приложении</p></a>
    </div>
  </div>
</Base>
