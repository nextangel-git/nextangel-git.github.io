---
import Base from '../layouts/Base.astro';
const formTarget = import.meta.env.PUBLIC_FORM_TARGET || 'uk@jks.ooo';
---
<Base title="Оставить заявку — УК «Жилкомсервис»"
      description="Онлайн-заявка в управляющую компанию «Жилкомсервис», Сосновоборск.">
  <div class="container house__wrap">
    <nav class="crumbs"><a href="/">Главная</a> → <span>Оставить заявку</span></nav>
    <div class="request-grid">
      <div>
        <h1>Оставить заявку</h1>
        <p class="disc-intro">Опишите проблему — отправим обращение на электронную почту УК. Если аварийная ситуация (прорыв, затопление, запах газа) — звоните сразу: <strong>8 (391-31) 2-00-62</strong> (круглосуточно).</p>

        <p id="request-unavailable" class="house__note">Если форма не появилась, включите JavaScript или напишите на <a href="mailto:uk@jks.ooo">uk@jks.ooo</a>. Телефон приёмной: 8 (391-31) 2-13-74.</p>
        <form id="request-form" class="form" data-target={formTarget} method="post" novalidate hidden>
          <fieldset id="request-fields" class="request-fields" aria-label="Обращение в УК" disabled>
          <label class="form__field">
            <span>ФИО *</span>
            <input type="text" name="fio" autocomplete="name" maxlength="150" required placeholder="Иванова Мария Петровна" />
          </label>
          <label class="form__field">
            <span>Телефон *</span>
            <input type="tel" name="phone" autocomplete="tel" maxlength="30" required placeholder="+7 (___) ___-__-__" />
          </label>
          <label class="form__field form__field--house">
            <span>Ваш дом *</span>
            <input type="text" id="req-house" name="house" maxlength="180" required placeholder="Начните вводить улицу…" autocomplete="off" />
            <div class="house-search__results" id="req-house-results" hidden></div>
          </label>
          <label class="form__field">
            <span>Квартира</span>
            <input type="text" name="flat" maxlength="20" placeholder="№ квартиры (необязательно)" />
          </label>
          <label class="form__field">
            <span>Тема *</span>
            <select name="topic" required>
              <option value="">— выберите —</option>
              <option>Сантехника</option>
              <option>Электрика</option>
              <option>Отопление</option>
              <option>Уборка подъезда / территории</option>
              <option>Шум / соседи</option>
              <option>Вопрос по квитанции</option>
              <option>Заказ платной услуги</option>
              <option>Другое</option>
            </select>
          </label>
          <label class="form__field form__field--wide">
            <span>Описание проблемы *</span>
            <textarea name="text" rows="5" maxlength="5000" required placeholder="Что случилось, где, когда началось…"></textarea>
          </label>
          <label class="form__check form__field--wide">
            <input type="checkbox" name="pdn" required />
            <span>Согласен на обработку персональных данных в соответствии с <a href="/privacy">политикой конфиденциальности</a> *</span>
          </label>
          <!-- ханипот: людям не видно, боты заполняют -->
          <input type="text" name="company" id="req-company" tabindex="-1" autocomplete="off" style="position:absolute;left:-9999px" aria-hidden="true" />
          <div class="form__field--wide">
            <button type="submit" class="btn btn--primary">Отправить заявку</button>
          </div>
          </fieldset>
        </form>

        <div id="request-done" class="form-done" role="status" tabindex="-1" hidden>
          <h2 id="request-heading">Обращение подготовлено</h2>
          <p>Код обращения: <strong id="request-num"></strong>. Он поможет найти письмо при обращении в УК. Эта форма не регистрирует заявку в личном кабинете.</p>
          <p class="house__note"></p>
          <p><a id="request-mailto" class="btn btn--primary" href="#" hidden>Открыть готовое письмо</a></p>
          <div id="request-copy" hidden>
            <label class="form__field"><span>Текст письма — можно скопировать вручную</span><textarea id="request-copy-text" rows="8" readonly></textarea></label>
            <button id="request-copy-button" class="btn btn--ghost" type="button">Скопировать текст</button>
          </div>
          <button id="request-back" class="btn btn--ghost" type="button" hidden>Вернуться к форме</button>
        </div>
      </div>

      <aside class="house__side">
        <div class="side-card side-card--accent">
          <h3>Аварийная ситуация?</h3>
          <p>Не ждите ответа на форму — звоните:</p>
          <a class="side-card__phone" href="tel:83913120062">8 (391-31) 2-00-62</a>
          <a class="side-card__phone" href="tel:83913120063">8 (391-31) 2-00-63</a>
          <p class="side-card__note">круглосуточно, без выходных</p>
        </div>
        <div class="side-card">
          <h3>Через личный кабинет</h3>
          <p>Заявки с фото и отслеживанием статуса:</p>
          <a class="btn btn--ghost" href="https://vss.krasinform.ru/login/" target="_blank" rel="noopener">Открыть личный кабинет</a>
        </div>
      </aside>
    </div>
  </div>

  <script>
    import housesAll from '../data/houses.json';
    const houses = housesAll.filter(h => !h.archived);
    const houseInput = document.getElementById('req-house');
    const houseResults = document.getElementById('req-house-results');
    const norm = (s) => String(s ?? '').toLowerCase().replace(/ё/g, 'е').trim();

    const params = new URLSearchParams(location.search);
    if (params.get('street') && params.get('num')) {
      houseInput.value = `ул. ${params.get('street')}, ${params.get('num')}`;
    }

    houseInput.addEventListener('input', () => {
      const q = norm(houseInput.value);
      if (q.length < 2) { houseResults.hidden = true; return; }
      const list = houses.filter((h) => norm(`${h.street} ${h.num}`).includes(q)).slice(0, 8);
      houseResults.innerHTML = '';
      for (const h of list) {
        const b = document.createElement('button');
        b.type = 'button';
        b.textContent = `ул. ${h.street}, ${h.num}`;
        b.addEventListener('click', () => {
          houseInput.value = `ул. ${h.street}, ${h.num}`;
          houseResults.hidden = true;
        });
        houseResults.appendChild(b);
      }
      houseResults.hidden = !list.length;
    });
    document.addEventListener('click', (e) => {
      if (!e.target.closest('.form__field--house')) houseResults.hidden = true;
    });

    const form = document.getElementById('request-form');
    let submitting = false;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (submitting) return;
      const phone = form.elements.phone;
      phone.setCustomValidity(phone.value.replace(/\D/g, '').length >= 10 ? '' : 'Введите телефон с кодом города или мобильного оператора.');
      for (const name of ['fio', 'text']) {
        const field = form.elements[name];
        field.setCustomValidity(field.value.trim() ? '' : 'Заполните это поле.');
      }
      houseInput.setCustomValidity(houseInput.value.trim() ? '' : 'Укажите адрес дома.');
      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }
      // Honeypot blocks automated submissions without silently discarding quick human input.
      if (form.elements.company.value !== '') return;
      const num = 'ЖКС-' + crypto.randomUUID();
      const btn = form.querySelector('button[type=submit]');
      submitting = true;
      btn.disabled = true;
      btn.textContent = 'Отправляем…';

      const FORM_TARGET = form.dataset.target;
      const fd = new FormData(form);
      const payload = {
        _subject: `Заявка ${num} с сайта: ${fd.get('topic')}`,
        'Номер заявки': num,
        'ФИО': fd.get('fio'),
        'Телефон': fd.get('phone'),
        'Дом': houseInput.value,
        'Квартира': fd.get('flat') || '—',
        'Тема': fd.get('topic'),
        'Описание': fd.get('text'),
        _template: 'table',
      };
      let sent = false;
      try {
        const res = await fetch(`https://formsubmit.co/ajax/${FORM_TARGET}`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
          body: JSON.stringify(payload),
          signal: AbortSignal.timeout(20000),
        });
        const data = await res.json().catch(() => null);
        sent = res.ok && data && String(data.success) === 'true';
      } catch { sent = false; }

      form.hidden = true;
      const done = document.getElementById('request-done');
      document.getElementById('request-num').textContent = num;
      const note = done.querySelector('.house__note');
      const mailtoBtn = document.getElementById('request-mailto');
      if (sent) {
        document.getElementById('request-heading').textContent = 'Сервис принял обращение';
        note.textContent = 'Сервис отправки принял письмо для УК. Это не подтверждение регистрации у диспетчера. Если вопрос срочный или ответ не поступает, позвоните: 8 (391-31) 2-13-74.';
        note.style.background = '';
        mailtoBtn.hidden = true;
      } else {
        document.getElementById('request-heading').textContent = 'Отправка не подтверждена';
        note.textContent = 'Не удалось подтвердить отправку. Откройте готовое письмо и отправьте его из своей почты на uk@jks.ooo либо скопируйте текст ниже. Повторное письмо может продублировать обращение, если сервис успел его принять. Можно позвонить: 8 (391-31) 2-13-74.';
        note.style.background = '#fffbeb';
        const body = [
          `Номер заявки: ${num}`, `ФИО: ${fd.get('fio')}`, `Телефон: ${fd.get('phone')}`,
          `Дом: ${houseInput.value}`, `Квартира: ${fd.get('flat') || '—'}`,
          `Тема: ${fd.get('topic')}`, '', fd.get('text'),
        ].join('\n');
        mailtoBtn.href = `mailto:uk@jks.ooo?subject=${encodeURIComponent('Заявка ' + num + ': ' + fd.get('topic'))}&body=${encodeURIComponent(body)}`;
        mailtoBtn.hidden = false;
        document.getElementById('request-copy-text').value = body;
        document.getElementById('request-copy').hidden = false;
        document.getElementById('request-back').hidden = false;
      }
      submitting = false;
      done.hidden = false;
      done.focus();
      done.scrollIntoView({ behavior: 'smooth', block: 'center' });
    });
    document.getElementById('request-copy-button').addEventListener('click', async () => {
      const field = document.getElementById('request-copy-text');
      try {
        await navigator.clipboard.writeText(field.value);
        document.getElementById('request-copy-button').textContent = 'Текст скопирован';
      } catch { field.focus(); field.select(); }
    });
    document.getElementById('request-back').addEventListener('click', () => {
      document.getElementById('request-done').hidden = true;
      document.getElementById('request-copy').hidden = true;
      document.getElementById('request-back').hidden = true;
      form.hidden = false;
      const button = form.querySelector('button[type=submit]');
      button.disabled = false;
      button.textContent = 'Отправить заявку';
      form.elements.fio.focus();
    });
    form.addEventListener('input', e => e.target.setCustomValidity?.(''));
    // Make controls available only after every handler is installed. Without JS the
    // browser must not send personal data through a native form submission.
    document.getElementById('request-fields').disabled = false;
    form.hidden = false;
    document.getElementById('request-unavailable').hidden = true;
  </script>
  <style>
    .request-fields { grid-column: 1 / -1; display: grid; grid-template-columns: inherit; gap: inherit; min-width: 0; margin: 0; padding: 0; border: 0; }
  </style>
</Base>
