---
import Base from '../layouts/Base.astro';
import housesGeo from '../data/houses_geo.json';

// точные цифры — считаются из данных по домам, а не пишутся руками
const houseCount = housesGeo.length;
const totalArea = Math.round(housesGeo.reduce((s, h) => s + (h.area || 0), 0));
const totalFlats = housesGeo.reduce((s, h) => s + (h.flats || 0), 0);
const years = housesGeo.map((h) => h.year).filter(Boolean);
const oldest = Math.min(...years);
const fmt = (n) => n.toLocaleString('ru-RU');
---
<Base title="О компании — УК «Жилкомсервис»"
      description="ООО УК «Жилкомсервис» — управление многоквартирными домами Сосновоборска с 2007 года.">
  <div class="container house__wrap">
    <nav class="crumbs"><a href="/">Главная</a> → <span>О компании</span></nav>
    <h1>О компании</h1>

    <div class="facts">
      <div class="fact"><strong>{houseCount}</strong><span>дома в управлении</span></div>
      <div class="fact"><strong>{fmt(totalArea)} м²</strong><span>обслуживаемой площади</span></div>
      <div class="fact"><strong>{fmt(totalFlats)}</strong><span>квартир обслуживаем</span></div>
      <div class="fact"><strong>с 2007</strong><span>года работаем в Сосновоборске</span></div>
    </div>

    <div class="about-text">
      <p>Управляющая компания «Жилкомсервис» оказывает услуги по управлению и обслуживанию многоквартирных жилых домов с 2007 года. В управлении находятся {houseCount} жилых дома города Сосновоборска общей площадью {fmt(totalArea)} м² — от дома {oldest} года постройки до новостроек.</p>
      <p>Главная цель компании — профессиональное предоставление качественных жилищно-коммунальных услуг жителям. Приоритетным направлением с самого начала деятельности стало качество услуг в рамках договора управления и обеспечение технической эксплуатации многоквартирных домов.</p>
      <p class="section__note" style="margin-top:14px">Цифры по портфелю — точные, рассчитаны по перечню домов на {new Date().toLocaleDateString('ru-RU', { month: 'long', year: 'numeric' })}.</p>
    </div>

    <div class="disc-grid" style="margin-top:28px">
      <a href="/disclosure" class="disc-card"><h3>Лицензия и устав</h3><p>Лицензия на управление МКД, уставные документы</p></a>
      <a href="/#contacts" class="disc-card"><h3>Реквизиты</h3><p>ИНН, ОГРН, юридический адрес — в разделе контактов</p></a>
      <a href="/news" class="disc-card"><h3>Новости</h3><p>Что происходит в компании и ваших домах</p></a>
    </div>
  </div>
</Base>
