# Публичные параметры сборки. Значения не являются секретами.
# Astro читает PUBLIC_FORM_TARGET из .env при сборке.
# Получатель автоотправки через FormSubmit; адрес УК нужно активировать у сервиса.
PUBLIC_FORM_TARGET=uk@jks.ooo

# SITE_URL задаётся в окружении команды сборки (не через этот .env):
# PowerShell: $env:SITE_URL = 'https://jks.ooo'; npm run build
# Bash: SITE_URL=https://jks.ooo npm run build
# GitHub Actions: Settings → Secrets and variables → Actions → Variables → SITE_URL.
# Без переопределения используется https://nextangel-git.github.io.
# Токены GitHub, пароли и SESSION_SECRET в этот файл не добавлять.
